{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leeway.invalid/contracts/machine-consciousness/self-model-v0.schema.json",
  "title": "LeeWay Machine Consciousness Factual Self Model v0",
  "type": "object",
  "required": [
    "schemaVersion",
    "currentCycleStateHash",
    "currentWorkspaceHash",
    "globalAccessRatio",
    "claims",
    "formula",
    "selfModelHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "currentCycleStateHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "currentWorkspaceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "globalAccessRatio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "claims": {
      "type": "object",
      "required": [
        "identity",
        "capabilities",
        "authority",
        "resources",
        "epistemic",
        "history"
      ],
      "properties": {
        "identity": {
          "type": "object",
          "required": [
            "claimClass",
            "value"
          ],
          "properties": {
            "claimClass": {
              "enum": [
                "VERIFIED_FROM_RUNTIME",
                "DERIVED",
                "UNKNOWN"
              ]
            },
            "value": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "capabilities": {
          "type": "object",
          "required": [
            "claimClass",
            "value"
          ],
          "properties": {
            "claimClass": {
              "enum": [
                "VERIFIED_FROM_RUNTIME",
                "DERIVED",
                "UNKNOWN"
              ]
            },
            "value": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "authority": {
          "type": "object",
          "required": [
            "claimClass",
            "value"
          ],
          "properties": {
            "claimClass": {
              "enum": [
                "VERIFIED_FROM_RUNTIME",
                "DERIVED",
                "UNKNOWN"
              ]
            },
            "value": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object",
          "required": [
            "claimClass",
            "value"
          ],
          "properties": {
            "claimClass": {
              "enum": [
                "VERIFIED_FROM_RUNTIME",
                "DERIVED",
                "UNKNOWN"
              ]
            },
            "value": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "epistemic": {
          "type": "object",
          "required": [
            "claimClass",
            "value"
          ],
          "properties": {
            "claimClass": {
              "enum": [
                "VERIFIED_FROM_RUNTIME",
                "DERIVED",
                "UNKNOWN"
              ]
            },
            "value": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "history": {
          "type": "object",
          "required": [
            "claimClass",
            "value"
          ],
          "properties": {
            "claimClass": {
              "enum": [
                "VERIFIED_FROM_RUNTIME",
                "DERIVED",
                "UNKNOWN"
              ]
            },
            "value": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "formula": {
      "type": "object",
      "required": [
        "id",
        "executionState"
      ],
      "properties": {
        "id": {
          "const": "LEEWAY-FORMULA-v1.0"
        },
        "executionState": {
          "const": "NOT_EXECUTED"
        }
      },
      "additionalProperties": false
    },
    "selfModelHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": true
}
